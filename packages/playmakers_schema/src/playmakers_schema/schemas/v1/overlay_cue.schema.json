{
  "$defs": {
    "CueProvenance": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "enum": [
            "tactics",
            "storyline",
            "what_if",
            "graphics"
          ],
          "title": "Agent",
          "type": "string"
        },
        "attempts": {
          "default": 1,
          "minimum": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "compliance": {
          "enum": [
            "verified",
            "template_fallback",
            "not_reviewed"
          ],
          "title": "Compliance",
          "type": "string"
        },
        "insight_headline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Insight Headline"
        },
        "metric_evidence": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Metric Evidence",
          "type": "object"
        },
        "metrics": {
          "additionalProperties": true,
          "title": "Metrics",
          "type": "object"
        },
        "personalized_for": {
          "anyOf": [
            {
              "enum": [
                "analyst",
                "casual"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Personalized For"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "source": {
          "enum": [
            "agent",
            "template",
            "simulation"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "agent",
        "source",
        "compliance"
      ],
      "title": "CueProvenance",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        }
      },
      "title": "Evidence",
      "type": "object"
    },
    "GoalThreat": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "features": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Features",
          "type": "object"
        },
        "horizon_ms": {
          "const": 120000,
          "default": 120000,
          "title": "Horizon Ms",
          "type": "integer"
        },
        "level": {
          "enum": [
            "Low",
            "Medium",
            "High"
          ],
          "title": "Level",
          "type": "string"
        },
        "probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
        },
        "team_id": {
          "title": "Team Id",
          "type": "string"
        }
      },
      "required": [
        "team_id",
        "probability",
        "level",
        "features",
        "evidence"
      ],
      "title": "GoalThreat",
      "type": "object"
    }
  },
  "$id": "https://playmakers.local/schemas/overlay_cue/1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "clock_ms": {
      "minimum": 0,
      "title": "Clock Ms",
      "type": "integer"
    },
    "cue_id": {
      "title": "Cue Id",
      "type": "string"
    },
    "duration_ms": {
      "default": 4000,
      "maximum": 30000,
      "minimum": 250,
      "title": "Duration Ms",
      "type": "integer"
    },
    "evidence_event_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Event Ids",
      "type": "array"
    },
    "goal_threat": {
      "items": {
        "$ref": "#/$defs/GoalThreat"
      },
      "title": "Goal Threat",
      "type": "array"
    },
    "language": {
      "anyOf": [
        {
          "enum": [
            "en",
            "es",
            "fr"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "layer": {
      "default": "lower_third",
      "enum": [
        "lower_third",
        "score_bug",
        "full_screen"
      ],
      "title": "Layer",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "persona": {
      "anyOf": [
        {
          "enum": [
            "analyst",
            "casual"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Persona"
    },
    "priority": {
      "default": 0,
      "maximum": 100,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/CueProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "safe_area": {
      "const": "broadcast_safe",
      "default": "broadcast_safe",
      "title": "Safe Area",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "template": {
      "title": "Template",
      "type": "string"
    }
  },
  "required": [
    "cue_id",
    "clock_ms",
    "template",
    "payload",
    "evidence_event_ids"
  ],
  "title": "OverlayCue",
  "type": "object"
}
