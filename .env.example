# Export values in your shell; Playmakers does not automatically load this file.
# Leave these unset for the credential-free deterministic mock.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-model-deployment
# AZURE_AI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
# AZURE_AI_MODEL_DEPLOYMENT=your-model-deployment
# Live default is the API's own mount; use :8765/mcp for the standalone `python -m stats_mcp`.
# STATS_MCP_URL=http://127.0.0.1:8000/stats-mcp/
# User-assigned managed identity client id (Azure Container Apps). Not a secret.
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Live-model timeouts in seconds (defaults 8 / 3 / 3 live, 4 / 1.5 / 1.5 offline).
# PLAYMAKERS_AGENT_TIMEOUT_S=8
# PLAYMAKERS_TRANSLATION_TIMEOUT_S=3
# PLAYMAKERS_WHATIF_TIMEOUT_S=3
# WHATIF_WORKERS=1

# Tracing to Application Insights (needs: pip install -e "services/replay_api[azure]").
# The connection string is an ingestion identifier, not a key; still keep it out of git.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
# PLAYMAKERS_TRACE_CONTENT=1

# Public-demo limits; matches beyond them play on the offline crew with an "Offline demo" badge.
# PLAYMAKERS_MAX_LIVE_MATCHES=2
# PLAYMAKERS_DAILY_LIVE_MATCHES=15
# PLAYMAKERS_SPEECH_PER_MINUTE=20
# PLAYMAKERS_SPEECH_TOTAL_PER_MINUTE=120

# Comma-separated browser origins permitted by the API (read at process start).
# CORS_ORIGINS=http://localhost:5173,https://your-web.example
# VITE_API_BASE=http://localhost:8000
# Docker web runtime API base; /api uses the bundled nginx proxy to API_UPSTREAM.
# API_BASE=/api
# API_UPSTREAM=http://api:8000   (empty disables the proxy; then API_BASE=https://<api>)

# Optional Azure AI Speech commentary. Server-only key auth, or Microsoft Entra ID
# via DefaultAzureCredential (role "Cognitive Services Speech User").
# AZURE_SPEECH_KEY=<server-only-speech-key>
# PLAYMAKERS_DAILY_SPEECH_CHARS=60000
# AZURE_SPEECH_REGION=westeurope
# AZURE_SPEECH_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<name>
# AZURE_SPEECH_ENDPOINT=https://<custom-subdomain>.cognitiveservices.azure.com
