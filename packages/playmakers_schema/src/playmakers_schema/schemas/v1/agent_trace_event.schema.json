{
  "$id": "https://playmakers.local/schemas/agent_trace_event/1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "title": "Action",
      "type": "string"
    },
    "agent": {
      "title": "Agent",
      "type": "string"
    },
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "number"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "default": "ok",
      "enum": [
        "ok",
        "rejected",
        "retry",
        "fallback",
        "error"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "agent",
    "action",
    "latency_ms"
  ],
  "title": "AgentTraceEvent",
  "type": "object"
}
