{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playmakers.local/schemas/match-event/1.0.0.json",
  "title": "Playmakers MatchEvent (v1.0.0)",
  "description": "Versioned match event schema for Playmakers / PitchSim.",
  "oneOf": [
    { "$ref": "#/$defs/period_start" },
    { "$ref": "#/$defs/period_end" },
    { "$ref": "#/$defs/kickoff" },
    { "$ref": "#/$defs/possession_change" },
    { "$ref": "#/$defs/pass" },
    { "$ref": "#/$defs/carry" },
    { "$ref": "#/$defs/tackle" },
    { "$ref": "#/$defs/foul" },
    { "$ref": "#/$defs/card" },
    { "$ref": "#/$defs/substitution" },
    { "$ref": "#/$defs/shot" },
    { "$ref": "#/$defs/goal" },
    { "$ref": "#/$defs/tracking_frame" }
  ],
  "$defs": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "period": { "type": "integer", "enum": [1, 2] },
    "nullable_string": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "vec2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 105 },
        "y": { "type": "number", "minimum": 0, "maximum": 68 }
      }
    },
    "base": {
      "type": "object",
      "required": ["schema_version", "event_id", "match_id", "sequence", "clock_ms", "period", "labels"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "event_id": { "type": "string" },
        "match_id": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 0 },
        "clock_ms": { "type": "integer", "minimum": 0 },
        "period": { "$ref": "#/$defs/period" },
        "team_id": { "$ref": "#/$defs/nullable_string" },
        "player_id": { "$ref": "#/$defs/nullable_string" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "ground_truth": {
          "anyOf": [{ "type": "object", "additionalProperties": true }, { "type": "null" }]
        }
      }
    },
    "period_start": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["event_type"],
          "properties": { "event_type": { "type": "string", "const": "period_start" } }
        }
      ],
      "unevaluatedProperties": false
    },
    "period_end": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["event_type"],
          "properties": { "event_type": { "type": "string", "const": "period_end" } }
        }
      ],
      "unevaluatedProperties": false
    },
    "kickoff": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["event_type", "start_position"],
          "properties": {
            "event_type": { "type": "string", "const": "kickoff" },
            "start_position": { "$ref": "#/$defs/vec2" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "possession_change": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["event_type", "reason", "ball_position"],
          "properties": {
            "event_type": { "type": "string", "const": "possession_change" },
            "from_team_id": { "$ref": "#/$defs/nullable_string" },
            "to_team_id": { "$ref": "#/$defs/nullable_string" },
            "reason": { "type": "string" },
            "ball_position": { "$ref": "#/$defs/vec2" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "pass": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": [
            "event_type",
            "from_player_id",
            "to_player_id",
            "start_position",
            "end_position",
            "distance_m",
            "completed",
            "pressure",
            "difficulty"
          ],
          "properties": {
            "event_type": { "type": "string", "const": "pass" },
            "from_player_id": { "type": "string" },
            "to_player_id": { "type": "string" },
            "start_position": { "$ref": "#/$defs/vec2" },
            "end_position": { "$ref": "#/$defs/vec2" },
            "distance_m": { "type": "number", "minimum": 0 },
            "completed": { "type": "boolean" },
            "pressure": { "type": "number", "minimum": 0, "maximum": 1 },
            "difficulty": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "carry": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["event_type", "start_position", "end_position", "distance_m", "pressure"],
          "properties": {
            "event_type": { "type": "string", "const": "carry" },
            "start_position": { "$ref": "#/$defs/vec2" },
            "end_position": { "$ref": "#/$defs/vec2" },
            "distance_m": { "type": "number", "minimum": 0 },
            "pressure": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "tackle": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["event_type", "tackler_player_id", "target_player_id", "position", "won_ball"],
          "properties": {
            "event_type": { "type": "string", "const": "tackle" },
            "tackler_player_id": { "type": "string" },
            "target_player_id": { "type": "string" },
            "position": { "$ref": "#/$defs/vec2" },
            "won_ball": { "type": "boolean" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "foul": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["event_type", "fouler_player_id", "fouled_player_id", "position", "card_awarded"],
          "properties": {
            "event_type": { "type": "string", "const": "foul" },
            "fouler_player_id": { "type": "string" },
            "fouled_player_id": { "type": "string" },
            "position": { "$ref": "#/$defs/vec2" },
            "card_awarded": { "type": "string", "enum": ["none", "yellow", "red"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "card": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["event_type", "carded_player_id", "color", "reason"],
          "properties": {
            "event_type": { "type": "string", "const": "card" },
            "carded_player_id": { "type": "string" },
            "color": { "type": "string", "enum": ["yellow", "red"] },
            "reason": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "substitution": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["event_type", "team_id", "player_out_id", "player_in_id", "reason"],
          "properties": {
            "event_type": { "type": "string", "const": "substitution" },
            "team_id": { "type": "string" },
            "player_out_id": { "type": "string" },
            "player_in_id": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "shot": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["event_type", "shooter_player_id", "position", "xg", "outcome"],
          "properties": {
            "event_type": { "type": "string", "const": "shot" },
            "shooter_player_id": { "type": "string" },
            "position": { "$ref": "#/$defs/vec2" },
            "body_part": { "type": "string", "enum": ["left_foot", "right_foot", "head", "other"] },
            "xg": { "type": "number", "minimum": 0, "maximum": 1 },
            "outcome": { "type": "string", "enum": ["goal", "saved", "blocked", "off_target", "woodwork"] },
            "shot_speed_kmh": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "goal": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["event_type", "scoring_team_id", "scorer_player_id", "shot_event_id"],
          "properties": {
            "event_type": { "type": "string", "const": "goal" },
            "scoring_team_id": { "type": "string" },
            "scorer_player_id": { "type": "string" },
            "assist_player_id": { "$ref": "#/$defs/nullable_string" },
            "shot_event_id": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "tracking_player_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player_id", "team_id", "position", "vx", "vy"],
      "properties": {
        "player_id": { "type": "string" },
        "team_id": { "type": "string" },
        "position": { "$ref": "#/$defs/vec2" },
        "vx": { "type": "number" },
        "vy": { "type": "number" }
      }
    },
    "tracking_frame": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["event_type", "ball_position", "players"],
          "properties": {
            "event_type": { "type": "string", "const": "tracking_frame" },
            "ball_position": { "$ref": "#/$defs/vec2" },
            "players": { "type": "array", "items": { "$ref": "#/$defs/tracking_player_state" } }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
